# Chiave API di Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Porta del server sul Mac
PORT=8788

# Modello e livello di "effort" (low = risposte più rapide, ideale per la voce)
MODEL=claude-opus-5
EFFORT=low

# true = esegue comandi shell/AppleScript senza chiedere conferma sull'iPhone (sconsigliato)
AUTO_APPROVE=false

# Fallback automatico lato server se il modello rifiuta una richiesta (on/off)
FALLBACKS=on
