# IDLE SYNC — tutte le voci sono facoltative.

# Porta del server sul Mac
PORT=8788

# Motore: "claude-code" (predefinito) usa Claude Code già installato e autenticato sul Mac,
# senza API key. "api" usa la Claude API e richiede ANTHROPIC_API_KEY.
ENGINE=claude-code
# ANTHROPIC_API_KEY=sk-ant-...

# Modello (facoltativo). Con Claude Code un alias come "opus" o "sonnet"; vuoto = quello del tuo account.
MODEL=

# Valori iniziali delle Opzioni (poi si cambiano dal telefono)
EFFORT=low
AUTO_APPROVE=false

# Percorso di Claude Code, se non è nel PATH
# CLAUDE_BIN=/Users/tuonome/.local/bin/claude

# 1 = widget con dati di esempio, per provare l'interfaccia senza un Mac
# IDLE_DEMO=1
